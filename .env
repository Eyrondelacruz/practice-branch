# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# ── SQLite fallback (used when SUPABASE_URL is not set) ───────────────────────
SQLITE_DB_PATH=attendance.db

# ── Token Security ────────────────────────────────────────────────────────────
# Master HMAC secret — change this in production!
MASTER_SECRET=change_me_super_secret_key_32chars

# ── Twilio SMS ────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ── Gmail SMTP ────────────────────────────────────────────────────────────────
GMAIL_USER=your_school@gmail.com
GMAIL_APP_PASSWORD=your_16char_app_password
NOTIFICATION_FROM_NAME=School Attendance System

# ── App ───────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
